{
  "extends": "../dev/tsconfig.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "baseUrl": "./",
    "outDir": "./lib",
    "types": ["node"],
    "paths": {
      "@modules": ["src/modules/index"],
      "@modules/*": ["src/modules/*"],
      "@gql": ["src/gql/index"],
      "@gql/*": ["src/gql/*"]
    },
  },
  "exclude": [
    "node_modules",
    "lib",
    "doc"
  ]
}
