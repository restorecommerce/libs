{
  "name": "@restorecommerce/kafka-client",
  "version": "1.4.3",
  "description": "Opinionated Kafka Client for Microservices",
  "author": "n-fuse GmbH",
  "main": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/restorecommerce/kafka-client.git"
  },
  "license": "MIT",
  "keywords": [
    "restore",
    "commerce",
    "kafka",
    "client"
  ],
  "type": "module",
  "dependencies": {
    "@platformatic/kafka": "2.3.0",
    "@restorecommerce/logger": "^1.4.3",
    "@restorecommerce/rc-grpc-clients": "^5.2.3",
    "async": "3.2.6",
    "cls-rtracer": "2.6.4",
    "events": "3.3.0",
    "protobufjs": "8.6.3",
    "remeda": "2.39.0",
    "retry": "0.13.1"
  },
  "devDependencies": {
    "@restorecommerce/dev": "^0.3.2",
    "@types/async": "3.2.25",
    "cross-env": "10.1.0",
    "npm-run-all": "4.1.5",
    "rimraf": "6.1.3"
  },
  "scripts": {
    "test": "npm run lint && vitest run",
    "lint": "eslint src",
    "build:tsc": "tsc -p ./tsconfig.lib.json",
    "build:clean": "rimraf dist/",
    "build": "npm-run-all lint build:clean build:tsc",
    "postbuild": "cp ../../node_modules/@platformatic/wasm-utils/dist/native.wasm dist/"
  },
  "engines": {
    "node": ">= 12.0.0"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist"
        ]
      }
    }
  },
  "gitHead": "0a6f7c94bfb1811c5dd60ab8c4912a41299b3717"
}
